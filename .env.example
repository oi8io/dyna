# Copy this file to .env.local. Never commit real values.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep both switches disabled until quotas and the provider budget are verified.
APP_GENERATION_ENABLED=false
AI_PROVIDER_MODE=fake

# DeepSeek — server only
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Writing code runs on the reasoning model; planning runs on the fast one.
# Chain-of-thought is on by default and costs a long silent warm-up, which is
# pure overhead for a stage that emits a few hundred tokens of JSON.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
# Set to `disabled` to trade some code quality for a much shorter write stage.
DEEPSEEK_WRITE_THINKING=enabled
DEEPSEEK_TIMEOUT_MS=180000
# Abort only after this long with no bytes at all. Reasoning tokens count.
DEEPSEEK_IDLE_TIMEOUT_MS=45000
DEEPSEEK_MAX_OUTPUT_TOKENS=16384

# Supabase browser client — publishable values only
NEXT_PUBLIC_SUPABASE_URL=https://mxnbaaocwczbibkkulhr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server.
# There is deliberately no service-role key here: nothing in the app uses one.
# Access goes through RLS or SECURITY DEFINER functions, so the credential that
# could read and delete every user's data is never deployed.
SUPABASE_URL=https://mxnbaaocwczbibkkulhr.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://mxnbaaocwczbibkkulhr.supabase.co/auth/v1/.well-known/jwks.json

# Build executor.
# `local` bundles in-process with esbuild: it never runs the generated code,
# installs nothing and executes no build script. Works on any host.
# `sandbox` runs a real install-and-build in a Vercel microVM and only works on
# Vercel, where the platform supplies the OIDC token.
BUILD_EXECUTOR=local

# Only read when BUILD_EXECUTOR=sandbox.
# `vercel env pull` supplies VERCEL_OIDC_TOKEN after the project is linked.
VERCEL_OIDC_TOKEN=
SANDBOX_RUNTIME=node22
SANDBOX_VCPUS=1
SANDBOX_TIMEOUT_MS=45000

# Ceiling for one generation request. Only a guard against a run that never
# converges — a long-lived process has no platform wall clock to stay under.
GENERATION_DEADLINE_MS=600000

# Cost controls
# Set these only after confirming the application-level limits.
APP_PUBLIC_BUDGET_USD=
APP_NEW_USER_CREATE_LIMIT=
APP_NEW_USER_EDIT_LIMIT=
